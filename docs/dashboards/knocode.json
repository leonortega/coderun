{
  "title": "Knocode v0.4.0",
  "panels": [
    { "title": "Request rate", "expr": "rate(knocode_requests_total[5m])" },
    { "title": "BuildContext p95", "expr": "histogram_quantile(0.95, rate(knocode_build_context_duration_seconds_bucket[5m]))" },
    { "title": "Fail-open %", "expr": "rate(knocode_fail_open_total[5m]) / rate(knocode_requests_total[5m])" },
    { "title": "Indexed files", "expr": "knocode_index_files" }
  ]
}
