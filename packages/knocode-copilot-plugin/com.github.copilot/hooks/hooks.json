{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/knocode-hook.mjs\" session-start",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/knocode-hook.mjs\" pre-tool-use",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/knocode-hook.mjs\" post-tool-use",
        "timeout": 10
      }
    ]
  }
}