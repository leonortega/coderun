{
  "name": "opencode-coderun",
  "version": "0.9.0",
  "description": "Coderun AI Runtime plugin for OpenCode — context enrichment and tool-output compression via daemon",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "prepack": "node scripts/sync-version.mjs",
    "build": "node scripts/sync-version.mjs && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "coderun",
    "ai",
    "context",
    "daemon"
  ],
  "author": "Coderun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeonOrtega/coderun"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.22",
    "@types/node": "^22.7.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  }
}
