# === Project-specific ===
# Coderun runtime data (database, index, logs, cache)
.coderun/data.db
.coderun/data.db-wal
.coderun/data.db-shm
.coderun/index/
.coderun/logs/
.coderun/cache/
.coderun/artifacts/

# Coderun config is tracked, but runtime state is not
# .coderun/config.toml  ← tracked (project config)
# .coderun/profile.json ← tracked (project profile)
# .coderun/skills/      ← tracked (skill library)

# Evaluation results (generated)
eval/results/

