{
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["opencode-coderun"],
    "mcp": {
        "codebase-memory": {
            "command": ["npx", "-y", "codebase-memory-mcp"],
            "type": "local",
            "enabled": true
        },
        "engram": {
            "command": [".opencode/engram/engram.exe", "mcp", "--tools=agent"],
            "type": "local",
            "enabled": true
        }
    }
}
